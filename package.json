{
  "name": "acp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Attention Coordination Protocol (ACP), with Relay as the first implementation and Relay Blocks as the modular workflow layer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidkimai/acp.git"
  },
  "homepage": "https://github.com/davidkimai/acp",
  "bugs": {
    "url": "https://github.com/davidkimai/acp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "acp",
    "attention-coordination-protocol",
    "collective-deliberation",
    "civic-tech",
    "protocol",
    "relay",
    "evaluation",
    "skills"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:dist": "node dist/src/server.js",
    "cli": "tsx src/cli.ts",
    "demo:bootstrap": "bash scripts/demo/bootstrap-demo.sh --force",
    "demo:summary": "bash scripts/demo/demo-summary.sh",
    "pilot:data": "node scripts/pilot/pilot-data-handling.mjs",
    "blocks:pilot-review": "bash skills/compositions/pilot-cycle-review/run.sh",
    "blocks:export-generation": "bash skills/compositions/export-generation/run.sh",
    "blocks:surface-preflight": "bash skills/compositions/surface-preflight/run.sh",
    "blocks:foresight-submission-prep": "bash skills/compositions/foresight-submission-prep/run.sh",
    "blocks:public-hearing-end-to-end": "bash skills/compositions/public-hearing-end-to-end/run.sh",
    "skills:audit": "node scripts/skills/audit-skills.mjs",
    "skills:map": "node scripts/skills/build-constitutional-skills-map.mjs",
    "skills:eval": "node scripts/evals/run-skills-evals.mjs",
    "skills:compare": "node scripts/evals/run-skills-comparative.mjs",
    "skills:live-pilot": "node scripts/evals/run-skills-live-provider-pilot.mjs",
    "skills:live-portability": "node scripts/evals/run-skills-live-provider-portability.mjs",
    "skills:measured-generate": "node scripts/evals/run-skills-measured-comparative.mjs",
    "skills:measured-judge": "node scripts/evals/judge-skills-measured-outputs.mjs",
    "skills:live-adjudicate": "node scripts/evals/adjudicate-skills-live-portability.mjs",
    "skills:study:experimental": "tsx scripts/evals/run-skills-study-program.mjs experimental --max-budget-usd 12",
    "skills:study:adjudication": "tsx scripts/evals/run-skills-study-program.mjs adjudication --max-budget-usd 18 --max-arbitrations 18",
    "skills:study:adherence": "tsx scripts/evals/run-skills-study-program.mjs adherence",
    "skills:study:live": "tsx scripts/evals/run-skills-study-program.mjs live --max-budget-usd 10 --max-arbitrations 10",
    "skills:study:claims": "tsx scripts/evals/run-skills-study-program.mjs claims",
    "skills:study:all": "tsx scripts/evals/run-skills-study-program.mjs all --reuse-existing --max-budget-usd 18 --max-arbitrations 18",
    "skills:operator-review": "node scripts/evals/build-skills-operator-review.mjs",
    "skills:claims-package": "node scripts/evals/build-skills-v3-claims-package.mjs",
    "conformance:check": "node scripts/conformance/check-acp.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "batch:run": "tsx scripts/batch/run-batch.ts",
    "http:run": "node scripts/http-client/run-http-scenario.mjs",
    "visual:artifact": "node scripts/visual-artifacts/generate-visual-artifact.mjs",
    "dogfood:relay": "node scripts/dogfood/run-relay-dogfood.mjs",
    "dogfood:browser": "node scripts/dogfood/run-relay-dogfood.mjs",
    "report:bundle": "node scripts/report/build-report-bundle.mjs",
    "release:smoke": "node scripts/release/run-release-gate.mjs smoke",
    "release:backup-check": "node scripts/release/run-release-gate.mjs backup-check",
    "release:gate": "node scripts/release/run-release-gate.mjs gate",
    "public:package:audit": "node scripts/release/audit-public-package.mjs",
    "completion:audit": "node scripts/completion/run-completion-audit.mjs",
    "agents:bundle": "node scripts/agents/build-runtime-bundles.mjs",
    "benchmark:fixtures": "node scripts/benchmark/run-benchmark.mjs fixtures",
    "benchmark:demo": "node scripts/benchmark/run-benchmark.mjs demo",
    "benchmark:compare": "node scripts/benchmark/run-benchmark.mjs comparison",
    "benchmark:replay": "node scripts/benchmark/run-benchmark.mjs replay",
    "benchmark:ablation": "node scripts/benchmark/run-benchmark.mjs ablation",
    "benchmark:scale": "node scripts/benchmark/run-benchmark.mjs scale",
    "conference:rehearsal": "node scripts/conference/build-rehearsal-bundle.mjs",
    "conference:foresight": "node scripts/conference/build-foresight-package.mjs",
    "reproduce:claims": "node scripts/repro/build-load-bearing-claims-package.mjs",
    "workspace:export": "npm run build --silent && node scripts/workspace/workspace-archive.mjs export",
    "workspace:import": "npm run build --silent && node scripts/workspace/workspace-archive.mjs import",
    "adopter:starter": "tsx adopters/typescript-http-starter/src/run.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.6.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
