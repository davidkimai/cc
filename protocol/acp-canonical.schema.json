        "selectedCompositionId": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "traceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "producedArtifactIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "adherence": {
          "$ref": "#/$defs/ProceduralAdherence"
        },
        "escalation": {
          "$ref": "#/$defs/ProceduralEscalationProvenance"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "ProceduralLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "references",
        "artifactExpectations",
        "contestPoints"
