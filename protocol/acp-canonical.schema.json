        "role": {
          "$ref": "#/$defs/ProceduralRole"
        },
        "purpose": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "sourcePath": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "maturity": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "ProceduralArtifactExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "description",
