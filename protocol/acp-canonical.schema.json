        },
        "config": {
          "$ref": "#/$defs/CycleConfig"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Participant"
          }
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contribution"
          }
        },
        "routingDecisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RoutingDecision"
          }
        },
        "digests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Digest"
          }
        },
        "responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResponseRecord"
          }
        },
        "feedback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeedbackRecord"
          }
        },
        "telemetryEvents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TelemetryEvent"
          }
        },
        "auditEvents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuditEvent"
          }
        },
        "exports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExportArtifact"
          }
        },
        "metrics": {
          "$ref": "#/$defs/CycleMetrics"
        },
        "engineV2": {
          "$ref": "#/$defs/EngineV2Trace"
        },
        "proceduralLayer": {
          "$ref": "#/$defs/ProceduralLayer"
        }
