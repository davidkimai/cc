      "properties": {
        "expectedArtifactCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "allRequiredArtifactsProduced": {
          "type": "boolean"
        },
        "missingArtifactIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        }
      }
    },
    "ProceduralEscalationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "recommendedAction",
        "humanReviewRequired",
        "reasons"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "engine_v2",
            "skill_trace",
            "composition_trace",
            "operator",
            "study_judgment"
          ]
        },
        "recommendedAction": {
          "type": "string",
          "enum": [
            "release",
            "review",
            "revise_digest",
            "abstain"
          ]
