        "digests",
        "responses",
        "feedback",
        "telemetryEvents",
        "auditEvents",
        "exports"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "prompt": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "condition": {
          "$ref": "#/$defs/CycleCondition"
        },
        "status": {
          "$ref": "#/$defs/CycleStatus"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "openedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "submissionClosedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "routingCompletedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "releasedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "reflectionClosedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "archivedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "schedule": {
          "$ref": "#/$defs/CycleSchedule",
