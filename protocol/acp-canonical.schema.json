        "artifactExpectations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProceduralArtifactExpectation"
          }
        },
        "contestPoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProceduralContestPoint"
          }
        },
        "execution": {
          "$ref": "#/$defs/ProceduralExecution"
        }
      }
