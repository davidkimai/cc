        "pointId": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "stage": {
          "$ref": "#/$defs/ProceduralContestStage"
        },
        "prompt": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "defaultAction": {
          "$ref": "#/$defs/ProceduralContestDefaultAction"
        },
        "requiredHumanRole": {
          "type": "string",
          "enum": [
            "platform_admin",
            "workspace_admin",
            "facilitator",
            "research_analyst",
            "participant",
            "observer"
          ]
        }
      }
